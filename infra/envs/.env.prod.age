# Postgres memory settings. The defaults fit DB_MEM_LIMIT=2048m (512MB + 30 connections x 16MB +
# 128MB + 3 autovacuum workers x 128MB = 1504MB). With a larger limit, raise them here too: about
# a quarter of the limit for shared buffers and three quarters for the cache size.
# DB_SHARED_BUFFERS=512MB
# DB_WORK_MEM=16MB
# DB_MAINTENANCE_WORK_MEM=128MB
# DB_EFFECTIVE_CACHE_SIZE=1536MB
# DB_AUTOVACUUM_WORK_MEM=128MB
